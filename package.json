{
  "name": "energy-daddy",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "cd public && python3 -m http.server 5050",
    "cf:dev": "wrangler dev --local --port 5051",
    "cf:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply energy-daddy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply energy-daddy-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
