{
  "name": "energy-daddy",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "cd public && python3 -m http.server 5050",
    "cf:dev": "wrangler dev --port 5051",
    "cf:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ENERGY_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply ENERGY_DB --remote",
    "brain:test": "curl http://localhost:5051/api/live"
  },
  "devDependencies": {"wrangler": "^4.0.0"}
}
